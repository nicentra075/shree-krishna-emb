# Copy to key.properties (git-ignored) after generating the upload keystore:
#
#   keytool -genkey -v \
#     -keystore ~/keystores/ske-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias ske-upload
#
# Store the .jks OUTSIDE the repo and back it up somewhere safe — losing it
# means losing the ability to update the app on Google Play.
# Then print the SHA fingerprints and add them to Firebase console
# (Project settings > Android app) or Google Sign-In breaks on release builds:
#
#   keytool -list -v -keystore ~/keystores/ske-upload.jks -alias ske-upload
#
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=ske-upload
storeFile=/Users/YOUR_USER/keystores/ske-upload.jks
