rules_version = '2';

// Phase 1 security rules — contract: docs/integration/FIRESTORE_SCHEMA.md
//
// Key principles:
// - Admin checks use CUSTOM CLAIMS (request.auth.token.role), synced from
//   users/{uid}.role by the onUserWrite Cloud Function. No billed get()s.
// - orders, purchases, stats, statsDaily, adminOtps, counters are written
//   ONLY by Cloud Functions (Admin SDK bypasses these rules).
// - The user app may only read designs with status == 'active'.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // Admin = custom claim (set by onUserWrite once Cloud Functions are
    // deployed) OR — as a fallback for the free/Spark phase where no functions
    // run — the caller's own users/{uid} doc has role == 'admin'. The claim
    // path short-circuits and avoids the billed get() once functions are live.
    // Safe against escalation: self-signup/self-update cannot set role to
    // 'admin' (see users create/update rules), so only an existing admin or a
    // Cloud Function can ever grant the admin role.
    function isAdmin() {
      return isAuthed() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // True only while the platform is in payment TEST mode
    // (config/platform.paymentTestMode == true). Used to let the client-side
    // demo/test checkout write its OWN order + purchase docs. In LIVE mode this
    // returns false, so orders/purchases are written ONLY by Cloud Functions
    // (createRazorpayOrder / finalizeOrder / initiateRefund via the Admin SDK,
    // which bypass these rules). Costs one get() per gated write — acceptable.
    function paymentTestMode() {
      return !exists(/databases/$(database)/documents/config/platform) ||
        get(/databases/$(database)/documents/config/platform)
          .data.get('paymentTestMode', true) == true;
    }

    // ==================== users ====================
    match /users/{uid} {
      // Owner + admin can read any field. Authorised-seller designer profiles
      // are also readable by any signed-in user so the user app can render the
      // "Authorised Design Sellers" list. NOTE: this exposes the whole user doc
      // (incl. email/phone) for authorised sellers — when Cloud Functions are
      // available, mirror only public store fields into a separate `sellers`
      // collection instead.
      allow read: if isOwner(uid) || isAdmin() ||
        (isAuthed() && resource.data.role == 'designer' &&
          resource.data.isAuthorisedSeller == true);
      // Self-signup may only claim 'user' or 'designer' — never 'admin'.
      allow create: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.role in ['user', 'designer']);
      // Owners cannot touch role/isActive/purchaseCount/isAuthorisedSeller
      // (only an admin can authorise a seller).
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'isActive', 'purchaseCount',
              'isAuthorisedSeller']));
      allow delete: if isAdmin();

      // Purchase index = ownership. LIVE mode: written only by finalizeOrder /
      // initiateRefund fns. TEST mode: the owner may grant their own purchase
      // after a demo/test checkout (see paymentTestMode()).
      match /purchases/{designId} {
        allow read: if isOwner(uid) || isAdmin();
        // PHASE-2 / TEST-MODE DEMO ONLY — auto-denied in Live mode.
        allow create: if isOwner(uid) && paymentTestMode();
        allow update, delete: if false;
      }
    }

    // ==================== collections ====================
    match /collections/{collectionId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ==================== designs ====================
    match /designs/{designId} {
      // User app must filter status == 'active' in every query.
      allow get, list: if isAdmin() ||
        (isAuthed() && resource.data.status == 'active');
      // Admin-managed catalog. `name` required; `price` is a non-negative int
      // (0 when the design is free — finalPrice is computed on the client).
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0;
      allow delete: if isAdmin();

      // Reviews — doc id = reviewer uid; create/update gated on purchase.
      match /reviews/{reviewerUid} {
        allow read: if true;
        allow create, update: if isOwner(reviewerUid) &&
          exists(/databases/$(database)/documents/users/$(reviewerUid)/purchases/$(designId)) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 1000;
        allow delete: if isOwner(reviewerUid) || isAdmin();
      }
    }

    // ==================== categories ====================
    match /categories/{categoryId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ==================== orders ====================
    // LIVE mode: written only by Cloud Functions (createRazorpayOrder /
    // finalizeOrder via the Admin SDK). TEST mode: the signed-in buyer may
    // write their own demo order from the client-side checkout.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isAuthed() && resource.data.userId == request.auth.uid);
      // PHASE-2 / TEST-MODE DEMO ONLY — auto-denied in Live mode.
      allow create: if isAuthed()
        && paymentTestMode()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['created', 'paid'];
      allow update, delete: if false;
    }

    // ==================== carts / wishlists (owner only) ====================
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /wishlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ==================== config ====================
    match /config/platform {
      allow read: if isAuthed();
      allow write: if isAdmin() &&
        request.resource.data.platformFeePercent is number &&
        request.resource.data.platformFeePercent >= 0 &&
        request.resource.data.platformFeePercent <= 100 &&
        request.resource.data.gstPercent is number &&
        request.resource.data.gstPercent >= 0 &&
        request.resource.data.gstPercent <= 100;
    }

    // Encrypted admin-managed secrets (e.g. AES-256-GCM Razorpay key secrets).
    // NO client access whatsoever — only Cloud Functions (Admin SDK, which
    // bypasses rules) read/write this. Written by setRazorpaySecret, read by
    // lib/razorpay.ts at runtime. The "is set" status the UI needs lives as a
    // non-sensitive boolean flag on config/platform instead.
    match /config/secrets {
      allow read, write: if false;
    }

    match /config/homeFeed {
      allow read: if isAuthed();
      // Server-driven home layout: an ordered list of section configs.
      allow write: if isAdmin() &&
        request.resource.data.sections is list &&
        request.resource.data.sections.size() <= 50;
    }

    // ==================== media library (admin) ====================
    // Index docs for reusable images in the admin Media Library. Admin-managed;
    // read allowed for any authed user (URLs are public anyway).
    match /media/{mediaId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ==================== design file library (admin) ====================
    // Index docs for reusable downloadable design source files. Admin-managed;
    // read allowed for any authed user (Storage URLs are public anyway).
    match /design_files/{fileId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ==================== stats (functions only) ====================
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /statsDaily/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==================== activity ====================
    match /activity/{activityId} {
      allow read: if isAdmin();
      // Admin client batches activity entries with design/category CRUD.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==================== locked collections ====================
    match /adminOtps/{uid} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ==================== config/notifications (admin) ====================
    match /config/notifications {
      allow read:  if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.dailySlots is list
        && request.resource.data.dailySlots.size() <= 4;
    }

    // ==================== fcm tokens (owner) ====================
    match /users/{uid}/fcm_tokens/{tokenId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isOwner(uid);
    }

    // ==================== user inbox (functions write) ====================
    match /users/{uid}/notifications/{id} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(uid);
    }

    // ==================== admin inbox (functions write) ====================
    match /admin_notifications/{id} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdmin();
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
