rules_version = '2';

// Phase 1 Storage rules — layout: docs/integration/FIRESTORE_SCHEMA.md §3
//
// - EMB/pattern sources and un-watermarked originals are NEVER client-readable.
//   Purchased files are delivered exclusively via the getDesignDownloadUrl
//   Cloud Function (15-minute signed URLs).
// - Watermarked previews/thumbs under public/ are written only by the
//   onDesignAssetUpload function (Admin SDK bypasses these rules).
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.role == 'admin';
    }

    // Designers get scoped catalog write access (Phase 1 decision D2).
    // The `role` claim is synced from users/{uid}.role by the
    // onUserRoleWritten / refreshRoleClaim Cloud Functions.
    function isDesigner() {
      return isAuthed() && request.auth.token.role == 'designer';
    }

    function isStaff() {
      return isAdmin() || isDesigner();
    }

    // EMB/DST source files — admin upload only, no client read ever.
    match /designs/{designId}/source/{fileName} {
      allow read: if false;
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
    }

    // Pristine un-watermarked images — admin only.
    match /designs/{designId}/original/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Watermarked previews + thumbnails — public read, function-written.
    match /designs/{designId}/public/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Home banners — public read, admin write.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // ===== Catalog images (admin panel uploads) =====
    // Direct uploads for collections / categories / designs and the Media
    // Library. Public read so the user app can render them. Writes are gated
    // on the `role` custom claim ('admin' or 'designer' — synced from
    // users/{uid}.role by the syncRoleClaim Cloud Functions). Plain `user`
    // accounts have NO write access here.
    match /collections/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    // Flat design images uploaded from the admin dialog (distinct from the
    // future function pipeline under designs/{designId}/{source|original|public}).
    match /designs/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /media/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    // Design source files (.dst/.emb/.dhe) for the Design File Library —
    // downloadable by the user app, so public read. NOT image content, so no
    // image contentType gate.
    match /design_files/{fileName} {
      allow read: if true;
      allow write: if isStaff() &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // Profile photos — public read, owner write.
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAuthed() && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
